{
  "vpmifyFormat": 1,
  "id": "net.kaikoga.vpmify.vci",
  "displayName": "VCI",
  "url": "https://vpm.kaikoga.net/vpmify/vci.json",
  "sources": [
    {
      "type": "github",
      "url": "https://github.com/virtual-cast/VCI",
      "tags": ">=0.32.0",
      "packages": [
        {
          "name": "com.virtualcast.univci",
          "path": "Assets/VCI",
          "overrides": [
            {
              "set": { "vpmDependencies": { "com.thirdparty.effekseer": "={sameTag}", "com.thirdparty.naudio": "={sameTag}" } }
            },
            {
              "versions": "<0.33.0",
              "merge": { "vpmDependencies": { "com.vrmc.unigltf": "={dependencies}", "com.vrmc.univrm": "={dependencies}", "com.vrmc.vrmshaders": "={dependencies}" } }
            },
            {
              "versions": ">=0.33.0",
              "merge": { "vpmDependencies": { "com.vrmc.gltf": "={dependencies}", "com.vrmc.univrm": "={dependencies}", "com.vrmc.vrm": "={dependencies}" } }
            },
            {
              "versions": ">=0.33.0 <0.45.0",
              "merge": { "vpmDependencies": { "com.vrmc.vrmshaders": "={dependencies}" } }
            },
            {
              "versions": "<0.35.0",
              "merge": { "dependencies": { "com.unity.textmeshpro": "2.1.6" } }
            },
            {
              "versions": ">=0.35.0 <0.42.0",
              "merge": { "dependencies": { "com.unity.textmeshpro": "3.0.6" } }
            },
            {
              "versions": ">=0.39.0 <0.41.0",
              "merge": { "dependencies": { "com.vrmc.gltf": "0.107.2", "com.vrmc.univrm": "0.107.2", "com.vrmc.vrm": "0.107.2", "com.vrmc.vrmshaders": "0.107.2" } }
            }
          ]
        },
        {
          "name": "com.thirdparty.effekseer",
          "path": "Assets/Effekseer",
          "versionFromTag": true
        },
        {
          "name": "com.thirdparty.naudio",
          "path": "Assets/NAudio",
          "versionFromTag": true
        }
      ]
    }
  ]
}
